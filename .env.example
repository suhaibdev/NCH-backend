# Copy this file to .env and replace every placeholder with a real value.
# Never commit .env. Only this example file belongs in git.

# Port the API server listens on (index.js). Optional; defaults to 5000.
PORT=5000

# MongoDB connection string (index.js, createAdmin.js). Required.
MONGODB_URI=your-mongodb-connection-string

# Secret used to sign and verify login tokens (src/middleware/authMiddleware.js,
# src/routes/auth.js). Required. Use a long random string.
JWT_SECRET=generate-a-long-random-string

# Shown in the startup log; defaults to "development". Set to "production" on
# the deployed server: that also turns on the HSTS header.
NODE_ENV=development

# Browser origins allowed to call the API (index.js). Comma-separated exact
# origins, no wildcard. If empty, every browser origin is blocked.
CORS_ALLOWED_ORIGINS=

# Used only by createAdmin.js to seed the first admin account. Both are required
# when running that script. Remove them from .env after the admin is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Optional. NCH bank details printed on GST invoices (src/config/sellerProfile.js).
# If ACCOUNT_NAME, ACCOUNT_NUMBER, IFSC or NAME is missing, the bank block is
# left off the invoice. BRANCH is optional. Never commit real values.
SELLER_BANK_ACCOUNT_NAME=
SELLER_BANK_ACCOUNT_NUMBER=
SELLER_BANK_IFSC=
SELLER_BANK_NAME=
SELLER_BANK_BRANCH=
